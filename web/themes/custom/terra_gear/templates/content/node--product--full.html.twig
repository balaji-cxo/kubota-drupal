{{ attach_library('terra_gear/global') }}
{% set p = product_data %}
<div class="pdp-page container">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ path('<front>') }}">Home</a><span>›</span><a href="{{ path('kubota_catalog.catalog') }}">All Products</a><span>›</span><a href="{{ path('kubota_catalog.catalog', {}, {'query': {'category': p.category_id}}) }}">{{ p.category }}</a><span>›</span>{{ p.part_number }}</nav>
  <div class="pdp-top">
    <div class="pdp-gallery">
      <div class="pdp-gallery__main"><img src="{{ p.gallery[0] }}" alt="{{ p.image_alt }}" data-gallery-main></div>
      <div class="pdp-gallery__thumbs">{% for image in p.gallery %}<button type="button" class="{{ loop.first ? 'is-active' : '' }}" data-gallery-thumb="{{ image }}" aria-label="View product image {{ loop.index }}"><img src="{{ image }}" alt=""></button>{% endfor %}</div>
    </div>
    <div class="pdp-summary">
      {% if p.badge %}<span class="product-badge product-badge--inline">{{ p.badge == 'best_seller' ? 'Best Seller' : p.badge|replace({'_': ' '})|title }}</span>{% endif %}
      <h1>{{ p.part_number }}</h1><p class="pdp-summary__category">{{ p.category }}</p>
      {% if p.reviews.count %}<div class="rating" aria-label="Average rating {{ p.reviews.average }} out of 5 from {{ p.reviews.count }} reviews"><span aria-hidden="true">{% for star in 1..5 %}<span class="{{ star > p.reviews.average|round ? 'rating--empty' : '' }}">★</span>{% endfor %}</span> <strong>{{ p.reviews.average }}</strong> ({{ p.reviews.count }} reviews)</div>{% endif %}
      <p class="pdp-intro">{{ p.summary }}</p>
      <div class="spec-tiles"><div><span>Width</span><strong>{{ p.width|number_format(0) }} mm</strong></div><div><span>Pitch</span><strong>{{ p.pitch|number_format(0) }} mm</strong></div><div><span>Links</span><strong>{{ p.links }}</strong></div><div><span>Weight</span><strong>{{ p.weight }} kg</strong></div><div><span>Application</span><strong>{{ p.application }}</strong></div></div>
      <div class="pdp-actions"><a class="button button--accent" href="{{ dealer_url }}">Find a Dealer →</a><label class="outline-button compare-check"><input type="checkbox" data-compare-product="{{ p.id }}"> Compare</label></div>
    </div>
  </div>
  {{ include('terra_gear:benefits-strip') }}
  <div class="pdp-tabs" role="tablist" aria-label="Product information"><button type="button" class="is-active" data-pdp-tab="specs">Specifications</button><button type="button" data-pdp-tab="compatibility">Compatibility</button><button type="button" data-pdp-tab="oem">OEM Cross-References</button><button type="button" data-pdp-tab="documents">Documents</button><button type="button" data-pdp-tab="reviews">Reviews ({{ p.reviews.count }})</button></div>
  <div class="pdp-tab-panel" data-pdp-panel="specs"><div class="pdp-details"><div><h2>Detailed Specifications</h2><table class="spec-table"><tbody><tr><th>Part Number</th><td>{{ p.part_number }}</td></tr><tr><th>Width</th><td>{{ p.width }} mm</td></tr><tr><th>Pitch</th><td>{{ p.pitch }} mm</td></tr><tr><th>Links</th><td>{{ p.links }}</td></tr><tr><th>Weight</th><td>{{ p.weight }} kg</td></tr><tr><th>Application</th><td>{{ p.application }}</td></tr><tr><th>Tread Pattern</th><td>{{ p.tread_pattern }}</td></tr><tr><th>Material</th><td>{{ p.material }}</td></tr><tr><th>Operating Temperature</th><td>{{ p.temperature_min }}°C to {{ p.temperature_max }}°C</td></tr></tbody></table></div><div><h2>Key Features</h2><ul class="feature-list">{% for feature in p.features %}<li>{{ feature }}</li>{% endfor %}</ul><h2>Downloads</h2><div class="download-list">{% for doc in p.documents %}<a href="{{ doc.url }}" target="_blank" rel="noopener">▧ {{ doc.label }} ↗</a>{% else %}<p>Documents will be added to this product.</p>{% endfor %}</div></div></div></div>
  <div class="pdp-tab-panel is-hidden" data-pdp-panel="compatibility"><h2>Compatible Machines</h2><ul class="simple-list">{% for machine in p.machines %}<li>{{ machine }}</li>{% else %}<li>Fitment information is being prepared.</li>{% endfor %}</ul></div>
  <div class="pdp-tab-panel is-hidden" data-pdp-panel="oem"><h2>OEM Cross-References</h2><ul class="simple-list">{% for ref in p.oem_refs %}<li>{{ ref }}</li>{% else %}<li>No OEM references listed.</li>{% endfor %}</ul></div>
  <div class="pdp-tab-panel is-hidden" data-pdp-panel="documents"><h2>Product Documents</h2><div class="download-list">{% for doc in p.documents %}<a href="{{ doc.url }}" target="_blank" rel="noopener">▧ {{ doc.label }} ↗</a>{% else %}<p>Documents will be added to this product.</p>{% endfor %}</div></div>
  <div class="pdp-tab-panel is-hidden" data-pdp-panel="reviews"><h2>Customer Reviews</h2>{% for review in p.reviews.items %}<article class="review"><div class="rating" aria-label="{{ review.rating }} out of 5 stars">{% for star in 1..5 %}<span class="{{ star > review.rating ? 'rating--empty' : '' }}" aria-hidden="true">★</span>{% endfor %}</div><h3>{{ review.title }}</h3><p>{{ review.body }}</p><strong>{{ review.author }}</strong></article>{% else %}<p>No reviews have been published yet.</p>{% endfor %}</div>
  {% if p.promo %}<section class="promo-banner pdp-promo" {% if p.promo.image %}style="--promo-image: url('{{ p.promo.image }}')"{% endif %}><div><span class="eyebrow">BUILT FOR DEMANDING JOBS</span><h2>{{ p.promo.heading }}</h2><p>{{ p.promo.text }}</p><a class="button button--light" href="{{ p.promo.cta_url ?: path('kubota_catalog.catalog') }}">{{ p.promo.cta_title ?: 'Learn More' }} →</a></div></section>{% endif %}
  <section class="section"><div class="section-heading"><div><h2>Compatible Machines</h2><p>Confirm this part matches your machine.</p></div></div><div class="fitment-box"><strong>Known compatible models</strong><div>{% for machine in p.machines %}<span class="fitment-chip">✓ {{ machine }}</span>{% else %}<span>Fitment details pending</span>{% endfor %}</div><form class="fitment-check" data-fitment-check data-compatible-models="{{ p.machine_ids|json_encode|e('html_attr') }}"><label for="fitment-model">Your model</label><select id="fitment-model" required><option value="">Select model</option>{% for model in machine_models %}<option value="{{ model.id }}">{{ model.label }}</option>{% endfor %}</select><button class="button button--accent" type="submit">Check Fitment</button><output aria-live="polite"></output></form></div></section>
  {% if related_products %}<section class="section"><div class="section-heading"><div><h2>Related Products</h2></div></div><div class="product-grid">{% for product in related_products %}{{ include('terra_gear:product-card', {product: product, compact: true}) }}{% endfor %}</div></section>{% endif %}
  {% if content.field_editorial_sections %}<section class="editorial-zone">{{ content.field_editorial_sections }}</section>{% endif %}
  {{ content.frontend_editing }}
</div>
