  {% elseif name == 'search' %}
    <circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
  {% elseif name == 'shield-check' %}
    <path d="m12 2 8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5l8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>
