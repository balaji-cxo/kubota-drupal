<svg class="tg-icon tg-icon--{{ name }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% if name == 'compare' %}
    <rect x="3" y="5" width="12" height="14" rx="1.5"/><path d="M9 2h10a2 2 0 0 1 2 2v14"/>
