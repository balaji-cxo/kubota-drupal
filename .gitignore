# Editor and OS files
/.vscode/
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Composer and Drupal dependencies (installed from composer.lock)
/vendor/
/web/core/
/web/libraries/
/web/modules/contrib/
/web/profiles/contrib/
/web/themes/contrib/

# Local backups and Composer credentials
/backup/
/database_dumps/
/auth.json

# Local Drupal settings and uploaded files
/web/sites/*/*settings*.php
!/web/sites/*/default.settings.php
/web/sites/*/*services*.yml
!/web/sites/*/default.services.yml
/web/sites/*/files/
/web/sites/*/private/
/web/sites/simpletest/

# PHP entry points scaffolded into the web root by Drupal core
/web/*.php
